# ─── Supabase (frontend — safe to expose) ────────────────────────────────────
# Find these in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Google (frontend — safe to expose) ──────────────────────────────────────
# Create an OAuth 2.0 Client ID in Google Cloud Console (Web Application type).
# Authorise https://localhost:5173 and your production domain as redirect URIs.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Picker API key (restricted to your domain + Picker API)
VITE_GOOGLE_PICKER_API_KEY=your-google-picker-api-key

# ─── Secrets — set these in Supabase Edge Function secrets, NOT here ─────────
# These are listed for documentation purposes only.
# Set them via: supabase secrets set KEY=value
#   or in: Supabase Dashboard → Edge Functions → Secrets
#
# SHOTSTACK_API_KEY=your-shotstack-api-key
# DEEPGRAM_API_KEY=your-deepgram-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
#
# These are auto-injected by Supabase into Edge Functions — do not set here:
# SUPABASE_URL         (injected automatically)
# SUPABASE_SERVICE_ROLE_KEY (injected automatically)
